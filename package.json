{
  "name": "humlens-procurement",
  "version": "0.1.0",
  "private": true,
  "prisma": {
    "seed": "ts-node ./prisma/seed.ts"
  },
  "scripts": {
    "dev": "next dev --port 4100",
    "dev:clean": "rm -rf .next && next dev --port 4100",
    "build": "prisma generate && prisma migrate deploy && next build",
    "start": "next start --port 4100",
    "check-types": "tsc --pretty --noEmit",
    "check-lint": "eslint .",
    "format": "prettier --write .",
    "test": "jest",
    "seed": "ts-node -r tsconfig-paths/register ./prisma/seed.ts",
    "mcp": "ts-node -r tsconfig-paths/register ./lib/mcp/stdio.ts",
    "agent-scheduler": "ts-node -r tsconfig-paths/register ./workers/agentScheduler.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@next-auth/prisma-adapter": "1.0.7",
    "@prisma/client": "6.3.1",
    "@tanstack/charts": "^0.18.0",
    "@tanstack/react-charts": "^0.18.0",
    "@tanstack/react-query": "^5.90.12",
    "@tanstack/react-query-devtools": "^5.103.2",
    "@tanstack/react-store": "^0.11.1",
    "@tanstack/react-table": "^9.2.4",
    "@tanstack/react-virtual": "^3.14.13",
    "@tanstack/store": "^0.11.1",
    "ai": "^5.0.0",
    "bcryptjs": "^2.4.3",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.47.0",
    "next": "14.2.15",
    "next-auth": "4.24.11",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hot-toast": "^2.4.1",
    "react-hotkeys-hook": "^5.3.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.7",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.15",
    "postcss": "^8.5.1",
    "prettier": "^3.4.2",
    "prisma": "6.3.1",
    "tailwindcss": "^3.4.17",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3"
  }
}
