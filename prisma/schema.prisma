generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =========================================================================
// Tenant / Auth — Team is the tenant. Every domain model below hangs off a
// teamId. Mirrors makeship's Team/User/TeamMember/Role shape so the RBAC and
// session patterns port over directly.
// =========================================================================

enum Role {
  OWNER
  ADMIN
  APPROVER
  FINANCE
  REQUESTER
  AUDITOR
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordReset {
  id        Int      @id @default(autoincrement())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

model User {
  id                     String    @id @default(uuid())
  name                   String
  email                  String    @unique
  emailVerified          DateTime?
  password               String?
  image                  String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @default(now()) @updatedAt
  invalid_login_attempts Int       @default(0)
  lockedAt               DateTime?
  disabled               Boolean   @default(false)

  accounts                Account[]
  sessions                Session[]
  teamMembers             TeamMember[]
  invitationsSent         Invitation[]
  requisitions            PurchaseRequisition[]
  approvalStepsAsApprover RequisitionApprovalStep[]
  approvalActions         ApprovalAction[]
  createdVendors          Vendor[]
  createdRfqs             RFQ[]
  createdContracts        Contract[]
  createdPurchaseOrders   PurchaseOrder[]           @relation("POCreatedBy")
  approvedPurchaseOrders  PurchaseOrder[]           @relation("POApprovedBy")
  receivedGoodsReceipts   GoodsReceipt[]
  reviewedInvoices        Invoice[]
  approvedPayments        Payment[]
  agentActionsReviewed    AgentAction[]
  auditLogs               AuditLog[]
  tablePreferences        TablePreference[]
  savedFilters            SavedFilter[]
}

model Team {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  domain      String?  @unique
  defaultRole Role     @default(REQUESTER)
  currency    String   @default("USD")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  members           TeamMember[]
  invitations       Invitation[]
  departments       Department[]
  vendors           Vendor[]
  categories        ProcurementCategory[]
  budgets           Budget[]
  requisitions      PurchaseRequisition[]
  approvalWorkflows ApprovalWorkflow[]
  purchaseOrders    PurchaseOrder[]
  rfqs              RFQ[]
  contracts         Contract[]
  goodsReceipts     GoodsReceipt[]
  invoices          Invoice[]
  payments          Payment[]
  agentPolicy       AgentPolicy?
  agentActions      AgentAction[]
  apiKeys           ApiKey[]
  auditLogs         AuditLog[]
  savedFilters      SavedFilter[]
  connections       Connection[]
  outboundEvents    OutboundEvent[]
  accountingLinks   AccountingLink[]
  punchoutCatalogs  PunchoutCatalog[]
  punchoutSessions  PunchoutSession[]

  @@index([domain])
}

model TeamMember {
  id           String   @id @default(uuid())
  teamId       String
  userId       String
  role         Role     @default(REQUESTER)
  departmentId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  team       Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id])

  @@unique([teamId, userId])
  @@index([userId])
  @@index([departmentId])
}

model Invitation {
  id        String   @id @default(uuid())
  teamId    String
  email     String
  role      Role     @default(REQUESTER)
  token     String   @unique
  expires   DateTime
  invitedBy String
  createdAt DateTime @default(now())

  team    Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  inviter User @relation(fields: [invitedBy], references: [id], onDelete: Cascade)

  @@unique([teamId, email])
  @@index([email])
}

model Department {
  id         String   @id @default(uuid())
  teamId     String
  name       String
  code       String?
  costCenter String?
  createdAt  DateTime @default(now())

  team         Team                  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  members      TeamMember[]
  budgets      Budget[]
  requisitions PurchaseRequisition[]

  @@unique([teamId, name])
  @@index([teamId])
}

// =========================================================================
// Catalog / Vendors
// =========================================================================

model ProcurementCategory {
  id       String  @id @default(uuid())
  teamId   String
  name     String
  parentId String?

  team             Team                  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  parent           ProcurementCategory?  @relation("CategoryParent", fields: [parentId], references: [id])
  children         ProcurementCategory[] @relation("CategoryParent")
  vendors          Vendor[]
  requisitionLines RequisitionLineItem[]

  @@unique([teamId, name])
  @@index([teamId])
}

enum VendorStatus {
  PENDING_APPROVAL
  ACTIVE
  INACTIVE
  BLOCKED
}

model Vendor {
  id                String       @id @default(uuid())
  teamId            String
  name              String
  legalName         String?
  status            VendorStatus @default(PENDING_APPROVAL)
  categoryId        String?
  taxId             String?
  website           String?
  email             String?
  phone             String?
  addressLine1      String?
  addressLine2      String?
  city              String?
  state             String?
  postalCode        String?
  country           String?
  paymentTerms      String?
  preferredCurrency String       @default("USD")
  rating            Float?
  notes             String?
  createdById       String
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @default(now()) @updatedAt

  team               Team                      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  category           ProcurementCategory?      @relation(fields: [categoryId], references: [id])
  createdBy          User                      @relation(fields: [createdById], references: [id])
  contacts           VendorContact[]
  rfqInvites         RFQVendor[]
  quotes             Quote[]
  purchaseOrders     PurchaseOrder[]
  contracts          Contract[]
  invoices           Invoice[]
  payments           Payment[]
  performanceReviews VendorPerformanceReview[]
  punchoutCatalog    PunchoutCatalog?

  @@unique([teamId, name])
  @@index([teamId])
  @@index([categoryId])
}

model VendorContact {
  id       String  @id @default(uuid())
  vendorId String
  name     String
  email    String?
  phone    String?
  title    String?

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
}

model VendorPerformanceReview {
  id          String   @id @default(uuid())
  vendorId    String
  teamId      String
  score       Float
  onTimeRate  Float?
  qualityRate Float?
  comment     String?
  createdAt   DateTime @default(now())

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
  @@index([teamId])
}

// =========================================================================
// Budgets
// =========================================================================

enum BudgetPeriod {
  MONTHLY
  QUARTERLY
  ANNUAL
}

model Budget {
  id              String       @id @default(uuid())
  teamId          String
  departmentId    String?
  name            String
  period          BudgetPeriod @default(ANNUAL)
  startDate       DateTime
  endDate         DateTime
  allocatedAmount Decimal      @db.Decimal(14, 2)
  committedAmount Decimal      @default(0) @db.Decimal(14, 2)
  spentAmount     Decimal      @default(0) @db.Decimal(14, 2)
  currency        String       @default("USD")
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @default(now()) @updatedAt

  team           Team                  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  department     Department?           @relation(fields: [departmentId], references: [id])
  requisitions   PurchaseRequisition[]
  purchaseOrders PurchaseOrder[]
  transactions   BudgetTransaction[]

  @@index([teamId])
  @@index([departmentId])
}

enum BudgetTransactionType {
  COMMIT
  RELEASE
  SPEND
  ADJUSTMENT
}

model BudgetTransaction {
  id        String                @id @default(uuid())
  budgetId  String
  type      BudgetTransactionType
  amount    Decimal               @db.Decimal(14, 2)
  reference String?
  note      String?
  createdAt DateTime              @default(now())

  budget Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  @@index([budgetId])
}

// =========================================================================
// Requisitions & Approvals
// =========================================================================

enum RequisitionStatus {
  DRAFT
  SUBMITTED
  IN_APPROVAL
  APPROVED
  REJECTED
  CONVERTED_TO_PO
  CANCELLED
}

model PurchaseRequisition {
  id                String            @id @default(uuid())
  teamId            String
  departmentId      String?
  budgetId          String?
  requesterId       String
  title             String
  justification     String?
  status            RequisitionStatus @default(DRAFT)
  currency          String            @default("USD")
  totalAmount       Decimal           @default(0) @db.Decimal(14, 2)
  neededBy          DateTime?
  // Set by connected systems (e.g. "store:<id>:<sku>:<date>") so a retried
  // request never raises the same requisition twice.
  externalReference String?
  submittedAt       DateTime?
  decidedAt         DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @default(now()) @updatedAt

  team          Team                      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  department    Department?               @relation(fields: [departmentId], references: [id])
  budget        Budget?                   @relation(fields: [budgetId], references: [id])
  requester     User                      @relation(fields: [requesterId], references: [id])
  lineItems     RequisitionLineItem[]
  approvalSteps RequisitionApprovalStep[]
  purchaseOrder PurchaseOrder?
  agentActions  AgentAction[]

  @@unique([teamId, externalReference])
  @@index([teamId])
  @@index([requesterId])
  @@index([status])
}

model RequisitionLineItem {
  id                String  @id @default(uuid())
  requisitionId     String
  categoryId        String?
  // Set when the line comes from a connected store or inventory system, so
  // goods received against it can be matched back to that product.
  sku               String?
  description       String
  quantity          Decimal @db.Decimal(12, 2)
  unit              String?
  estimatedPrice    Decimal @db.Decimal(14, 2)
  suggestedVendorId String?

  requisition PurchaseRequisition  @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  category    ProcurementCategory? @relation(fields: [categoryId], references: [id])

  @@index([requisitionId])
}

// Per-team policy: which amount band requires which sequence of approver
// roles. AI auto-approval (AgentPolicy) can only ever short-circuit steps
// within a band it's explicitly allowed to touch — see lib/ai/policy.ts.
model ApprovalWorkflow {
  id            String   @id @default(uuid())
  teamId        String
  name          String
  minAmount     Decimal  @default(0) @db.Decimal(14, 2)
  maxAmount     Decimal? @db.Decimal(14, 2)
  approverRoles Role[]
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])
}

enum ApprovalStepStatus {
  PENDING
  APPROVED
  REJECTED
  SKIPPED
  AUTO_APPROVED
}

model RequisitionApprovalStep {
  id            String             @id @default(uuid())
  requisitionId String
  stepOrder     Int
  requiredRole  Role
  approverId    String?
  status        ApprovalStepStatus @default(PENDING)
  decidedAt     DateTime?
  comment       String?

  requisition PurchaseRequisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  approver    User?               @relation(fields: [approverId], references: [id])
  actions     ApprovalAction[]

  @@unique([requisitionId, stepOrder])
  @@index([requisitionId])
}

model ApprovalAction {
  id           String             @id @default(uuid())
  stepId       String
  actorId      String?
  actedByAgent Boolean            @default(false)
  decision     ApprovalStepStatus
  comment      String?
  createdAt    DateTime           @default(now())

  step  RequisitionApprovalStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  actor User?                   @relation(fields: [actorId], references: [id])

  @@index([stepId])
}

// =========================================================================
// Strategic Sourcing — RFQ / Quotes / Contracts
// =========================================================================

enum RFQStatus {
  DRAFT
  SENT
  QUOTES_RECEIVED
  AWARDED
  CANCELLED
}

model RFQ {
  id              String    @id @default(uuid())
  teamId          String
  title           String
  description     String?
  status          RFQStatus @default(DRAFT)
  dueDate         DateTime?
  createdById     String
  awardedVendorId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt

  team          Team          @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdBy     User          @relation(fields: [createdById], references: [id])
  lineItems     RFQLineItem[]
  vendorInvites RFQVendor[]
  quotes        Quote[]
  contracts     Contract[]

  @@index([teamId])
}

model RFQLineItem {
  id          String  @id @default(uuid())
  rfqId       String
  description String
  quantity    Decimal @db.Decimal(12, 2)
  unit        String?

  rfq RFQ @relation(fields: [rfqId], references: [id], onDelete: Cascade)

  @@index([rfqId])
}

enum RFQVendorStatus {
  INVITED
  DECLINED
  QUOTED
}

model RFQVendor {
  id        String          @id @default(uuid())
  rfqId     String
  vendorId  String
  status    RFQVendorStatus @default(INVITED)
  invitedAt DateTime        @default(now())

  rfq    RFQ    @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([rfqId, vendorId])
  @@index([vendorId])
}

enum QuoteStatus {
  SUBMITTED
  SHORTLISTED
  AWARDED
  REJECTED
}

model Quote {
  id           String      @id @default(uuid())
  rfqId        String
  vendorId     String
  status       QuoteStatus @default(SUBMITTED)
  totalAmount  Decimal     @db.Decimal(14, 2)
  currency     String      @default("USD")
  leadTimeDays Int?
  notes        String?
  submittedAt  DateTime    @default(now())

  rfq       RFQ             @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  vendor    Vendor          @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  lineItems QuoteLineItem[]

  @@index([rfqId])
  @@index([vendorId])
}

model QuoteLineItem {
  id          String  @id @default(uuid())
  quoteId     String
  description String
  quantity    Decimal @db.Decimal(12, 2)
  unitPrice   Decimal @db.Decimal(14, 2)

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
}

enum ContractStatus {
  DRAFT
  ACTIVE
  EXPIRING_SOON
  EXPIRED
  TERMINATED
}

model Contract {
  id          String         @id @default(uuid())
  teamId      String
  vendorId    String
  rfqId       String?
  title       String
  status      ContractStatus @default(DRAFT)
  value       Decimal?       @db.Decimal(14, 2)
  currency    String         @default("USD")
  startDate   DateTime
  endDate     DateTime?
  autoRenew   Boolean        @default(false)
  documentUrl String?
  createdById String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @default(now()) @updatedAt

  team           Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  vendor         Vendor          @relation(fields: [vendorId], references: [id])
  rfq            RFQ?            @relation(fields: [rfqId], references: [id])
  createdBy      User            @relation(fields: [createdById], references: [id])
  purchaseOrders PurchaseOrder[]

  @@index([teamId])
  @@index([vendorId])
}

// =========================================================================
// Purchase Orders / Receiving / Invoices / Payments
// =========================================================================

enum POStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  ISSUED
  PARTIALLY_RECEIVED
  RECEIVED
  CLOSED
  CANCELLED
}

model PurchaseOrder {
  id              String    @id @default(uuid())
  teamId          String
  poNumber        String
  requisitionId   String?   @unique
  vendorId        String
  contractId      String?
  budgetId        String?
  status          POStatus  @default(DRAFT)
  currency        String    @default("USD")
  subtotal        Decimal   @default(0) @db.Decimal(14, 2)
  tax             Decimal   @default(0) @db.Decimal(14, 2)
  shipping        Decimal   @default(0) @db.Decimal(14, 2)
  totalAmount     Decimal   @default(0) @db.Decimal(14, 2)
  shippingAddress String?
  billingAddress  String?
  notes           String?
  createdById     String
  approvedById    String?
  approvedAt      DateTime?
  issuedAt        DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt

  team          Team                 @relation(fields: [teamId], references: [id], onDelete: Cascade)
  requisition   PurchaseRequisition? @relation(fields: [requisitionId], references: [id])
  vendor        Vendor               @relation(fields: [vendorId], references: [id])
  contract      Contract?            @relation(fields: [contractId], references: [id])
  budget        Budget?              @relation(fields: [budgetId], references: [id])
  createdBy     User                 @relation("POCreatedBy", fields: [createdById], references: [id])
  approvedBy    User?                @relation("POApprovedBy", fields: [approvedById], references: [id])
  lineItems     POLineItem[]
  goodsReceipts GoodsReceipt[]
  invoices      Invoice[]
  agentActions  AgentAction[]

  @@unique([teamId, poNumber])
  @@index([teamId])
  @@index([vendorId])
  @@index([status])
}

model POLineItem {
  id          String  @id @default(uuid())
  poId        String
  sku         String?
  description String
  quantity    Decimal @db.Decimal(12, 2)
  unit        String?
  unitPrice   Decimal @db.Decimal(14, 2)
  receivedQty Decimal @default(0) @db.Decimal(12, 2)
  invoicedQty Decimal @default(0) @db.Decimal(12, 2)

  purchaseOrder PurchaseOrder          @relation(fields: [poId], references: [id], onDelete: Cascade)
  receiptLines  GoodsReceiptLineItem[]
  invoiceLines  InvoiceLineItem[]

  @@index([poId])
}

enum ReceiptStatus {
  PENDING
  PARTIAL
  COMPLETE
  REJECTED
}

model GoodsReceipt {
  id           String        @id @default(uuid())
  teamId       String
  poId         String
  receivedById String
  status       ReceiptStatus @default(PENDING)
  receivedAt   DateTime      @default(now())
  notes        String?

  team          Team                   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  purchaseOrder PurchaseOrder          @relation(fields: [poId], references: [id])
  receivedBy    User                   @relation(fields: [receivedById], references: [id])
  lineItems     GoodsReceiptLineItem[]

  @@index([teamId])
  @@index([poId])
}

model GoodsReceiptLineItem {
  id               String  @id @default(uuid())
  receiptId        String
  poLineItemId     String
  quantityReceived Decimal @db.Decimal(12, 2)
  condition        String?

  receipt    GoodsReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  poLineItem POLineItem   @relation(fields: [poLineItemId], references: [id])

  @@index([receiptId])
  @@index([poLineItemId])
}

enum InvoiceStatus {
  RECEIVED
  UNDER_REVIEW
  MATCHED
  MISMATCHED
  APPROVED
  DISPUTED
  PAID
  CANCELLED
}

model Invoice {
  id            String        @id @default(uuid())
  teamId        String
  vendorId      String
  poId          String?
  invoiceNumber String
  status        InvoiceStatus @default(RECEIVED)
  currency      String        @default("USD")
  subtotal      Decimal       @default(0) @db.Decimal(14, 2)
  tax           Decimal       @default(0) @db.Decimal(14, 2)
  totalAmount   Decimal       @default(0) @db.Decimal(14, 2)
  dueDate       DateTime?
  issuedDate    DateTime?
  documentUrl   String?
  reviewedById  String?
  matchStatus   String?
  matchNotes    String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @default(now()) @updatedAt

  team          Team              @relation(fields: [teamId], references: [id], onDelete: Cascade)
  vendor        Vendor            @relation(fields: [vendorId], references: [id])
  purchaseOrder PurchaseOrder?    @relation(fields: [poId], references: [id])
  reviewedBy    User?             @relation(fields: [reviewedById], references: [id])
  lineItems     InvoiceLineItem[]
  payments      Payment[]
  agentActions  AgentAction[]

  @@unique([teamId, vendorId, invoiceNumber])
  @@index([teamId])
  @@index([poId])
  @@index([status])
}

model InvoiceLineItem {
  id           String  @id @default(uuid())
  invoiceId    String
  poLineItemId String?
  description  String
  quantity     Decimal @db.Decimal(12, 2)
  unitPrice    Decimal @db.Decimal(14, 2)
  amount       Decimal @db.Decimal(14, 2)

  invoice    Invoice     @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  poLineItem POLineItem? @relation(fields: [poLineItemId], references: [id])

  @@index([invoiceId])
}

enum PaymentStatus {
  SCHEDULED
  PROCESSING
  PAID
  FAILED
  CANCELLED
}

model Payment {
  id           String        @id @default(uuid())
  teamId       String
  vendorId     String
  invoiceId    String?
  amount       Decimal       @db.Decimal(14, 2)
  currency     String        @default("USD")
  status       PaymentStatus @default(SCHEDULED)
  method       String?
  scheduledFor DateTime?
  paidAt       DateTime?
  approvedById String?
  reference    String?
  createdAt    DateTime      @default(now())

  team       Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  vendor     Vendor   @relation(fields: [vendorId], references: [id])
  invoice    Invoice? @relation(fields: [invoiceId], references: [id])
  approvedBy User?    @relation(fields: [approvedById], references: [id])

  @@index([teamId])
  @@index([invoiceId])
}

// =========================================================================
// AI-native layer — per-team autonomy policy + an audit log of every
// autonomous action the agents took (or proposed). Every agent write goes
// through the same service-layer functions a human action would, and is
// logged here so it's reviewable/reversible. See lib/ai/agents/*.
// =========================================================================

model AgentPolicy {
  id                       String   @id @default(uuid())
  teamId                   String   @unique
  autoApproveEnabled       Boolean  @default(false)
  autoApproveMaxAmount     Decimal  @default(0) @db.Decimal(14, 2)
  autoApproveCategories    String[] @default([])
  autoMatchInvoices        Boolean  @default(true)
  autoMatchTolerancePct    Float    @default(2.0)
  autoDraftRfqOutreach     Boolean  @default(true)
  spendAnomalyThresholdPct Float    @default(25.0)
  // The model the team's agents run on: anthropic, openai, mistral or local (null: the deployment's default).
  aiProvider               String?
  aiModel                  String?
  // The team's own API key for that provider, encrypted (lib/secrets). Null: use the deployment's key.
  aiApiKey                 String?
  // For "local": the model server's OpenAI-compatible address (Ollama, LM Studio, vLLM). Null: LOCAL_AI_URL.
  aiBaseUrl                String?
  updatedAt                DateTime @default(now()) @updatedAt

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
}

enum AgentActionType {
  AUTO_APPROVE_REQUISITION
  AUTO_MATCH_INVOICE
  DRAFT_RFQ_OUTREACH
  RECOMMEND_VENDOR
  SPEND_ANOMALY_ALERT
  BUDGET_FORECAST
  NL_REQUISITION_DRAFT
}

enum AgentActionStatus {
  PROPOSED
  EXECUTED
  REJECTED_BY_POLICY
  OVERRIDDEN_BY_HUMAN
  REVERTED
  FAILED
}

// One row per thing an agent did, proposed or noticed. A row with a `tool`
// is a change that can be applied (and usually undone) through the action
// registry in lib/actions; a row without one is a finding for people to read.
model AgentAction {
  id              String            @id @default(uuid())
  teamId          String
  type            AgentActionType
  status          AgentActionStatus @default(PROPOSED)
  // Which agent acted: approval, invoice-match, nl-requisition, sourcing, spend-anomaly.
  agent           String?
  // One-line summary for the inbox, written when the action is proposed.
  title           String?
  requisitionId   String?
  purchaseOrderId String?
  invoiceId       String?
  input           Json              @default("{}")
  output          Json              @default("{}")
  // The exact change: an action name from lib/actions and its arguments.
  tool            String?
  args            Json?
  // What applying it produced (ids and previous values), used to undo it.
  result          Json?
  evidence        Json              @default("[]")
  reasoning       String?
  confidence      Float?
  aiModel         String?
  aiTokens        Int?
  error           String?
  // The person whose request produced this action (e.g. a plain-English requisition).
  requestedById   String?
  reviewedById    String?
  reviewedAt      DateTime?
  // Null appliedById with appliedAt set means the agent applied it on its own.
  appliedById     String?
  appliedAt       DateTime?
  revertedById    String?
  revertedAt      DateTime?
  createdAt       DateTime          @default(now())

  team          Team                 @relation(fields: [teamId], references: [id], onDelete: Cascade)
  requisition   PurchaseRequisition? @relation(fields: [requisitionId], references: [id])
  purchaseOrder PurchaseOrder?       @relation(fields: [purchaseOrderId], references: [id])
  invoice       Invoice?             @relation(fields: [invoiceId], references: [id])
  reviewedBy    User?                @relation(fields: [reviewedById], references: [id])

  @@index([teamId])
  @@index([type])
  @@index([teamId, status])
}

// =========================================================================
// Server-to-server access (a Humlens Commerce store, scripts)
// =========================================================================

// Only a SHA-256 hash is stored; the key itself is shown once, when it's
// created. Calls made with a key act as the member who created it, with
// that member's role — see lib/apiKey.ts.
model ApiKey {
  id          String    @id @default(uuid())
  teamId      String
  name        String
  prefix      String
  keyHash     String    @unique
  createdById String
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])
}

// =========================================================================
// Audit log — who did what, when, and through which entry point. Written by
// lib/audit.ts after a mutating request succeeds; never updated or deleted
// by the app.
// =========================================================================

enum AuditSource {
  APP
  API_KEY
  MCP
}

model AuditLog {
  id          String      @id @default(uuid())
  teamId      String
  actorId     String?
  // Snapshot so the entry still reads correctly after the user is deleted.
  actorName   String
  source      AuditSource @default(APP)
  resource    String
  action      String
  targetId    String?
  targetLabel String?
  ipAddress   String?
  createdAt   DateTime    @default(now())

  team  Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([teamId, createdAt])
}

// =========================================================================
// Per-user UI preferences — the saved layout of each list table (visible,
// ordered, sized and pinned columns, sorting, grouping, filters, page size,
// density). Keyed by page route, so it follows the user across teams and
// devices. Written by /api/me/table-preferences.
// =========================================================================

model TablePreference {
  id        String   @id @default(uuid())
  userId    String
  tableKey  String
  view      Json
  updatedAt DateTime @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tableKey])
}

// A named set of table filter conditions (lib/advancedFilter.ts) for one list
// page, kept for its creator or shared with the whole team. Managed through
// /api/teams/[slug]/saved-filters.
model SavedFilter {
  id          String   @id @default(uuid())
  teamId      String
  createdById String
  tableKey    String
  name        String
  filter      Json
  shared      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  team      Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdBy User @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([teamId, tableKey])
}

// =========================================================================
// Connected apps — the other Humlens apps this team talks to, and every
// message sent to them (lib/connections.ts, lib/outbox.ts).
// =========================================================================

enum ConnectionKind {
  INVENTORY
  PROCUREMENT
  COMMERCE
  // An accounting system or ERP (QuickBooks, Xero, Sage, NetSuite): see lib/accounting.
  ACCOUNTING
  // Outbox target only: cXML orders sent to a supplier's PunchOut order URL (lib/punchout).
  SUPPLIER
}

// `secret` is encrypted (lib/secrets.ts): the other app's API key, or for
// COMMERCE the key that signs notifications sent to the store.
model Connection {
  id            String         @id @default(uuid())
  teamId        String
  kind          ConnectionKind
  url           String
  secret        String
  options       Json           @default("{}")
  createdById   String?
  lastSuccessAt DateTime?
  lastError     String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @default(now()) @updatedAt

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, kind])
}

enum OutboundStatus {
  PENDING
  DELIVERED
  FAILED
}

// Outbox: written in the same step as the change it reports, then delivered
// with retries, so a slow or offline app never loses an update. `reference`
// is also what the receiving app de-duplicates on.
model OutboundEvent {
  id            String         @id @default(uuid())
  teamId        String
  target        ConnectionKind
  kind          String
  reference     String
  payload       Json
  status        OutboundStatus @default(PENDING)
  attempts      Int            @default(0)
  lastError     String?
  nextAttemptAt DateTime       @default(now())
  deliveredAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @default(now()) @updatedAt

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, reference])
  @@index([status, nextAttemptAt])
  @@index([teamId, createdAt])
}

// =========================================================================
// Accounting and ERP sync (lib/accounting). The connection itself is a
// Connection of kind ACCOUNTING; this maps each record here to the one it
// created there, so a retried sync never creates it twice.
// =========================================================================

enum AccountingRecordKind {
  VENDOR
  PURCHASE_ORDER
  BILL
  PAYMENT
}

model AccountingLink {
  id             String               @id @default(uuid())
  teamId         String
  kind           AccountingRecordKind
  localId        String
  provider       String
  externalId     String
  externalNumber String?
  syncedAt       DateTime             @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, kind, localId])
  @@index([teamId, kind])
}

// =========================================================================
// PunchOut (lib/punchout): requesters shop a supplier's own site and the cart
// comes back as requisition lines. cXML or SAP OCI, one catalog per vendor.
// =========================================================================

enum PunchoutProtocol {
  CXML
  OCI
}

model PunchoutCatalog {
  id             String           @id @default(uuid())
  teamId         String
  vendorId       String           @unique
  protocol       PunchoutProtocol @default(CXML)
  setupUrl       String
  // cXML credentials: From (us, as the supplier knows us), To (the supplier), Sender.
  fromDomain     String           @default("NetworkID")
  fromIdentity   String?
  toDomain       String           @default("NetworkID")
  toIdentity     String?
  senderIdentity String?
  // OCI login name; the password (or cXML SharedSecret) is `secret`, encrypted.
  username       String?
  secret         String?
  // cXML OrderRequest endpoint: issued POs are sent here when sendOrders is on.
  orderUrl       String?
  sendOrders     Boolean          @default(false)
  enabled        Boolean          @default(true)
  lastError      String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @default(now()) @updatedAt

  team     Team              @relation(fields: [teamId], references: [id], onDelete: Cascade)
  vendor   Vendor            @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  sessions PunchoutSession[]

  @@index([teamId])
}

enum PunchoutSessionStatus {
  STARTED
  RETURNED
  FAILED
}

// One shopping trip. `token` is the unguessable part of the return address
// the supplier posts the cart to; it works once, for two hours.
model PunchoutSession {
  id            String                @id @default(uuid())
  teamId        String
  catalogId     String
  userId        String
  token         String                @unique
  requisitionId String?
  status        PunchoutSessionStatus @default(STARTED)
  itemCount     Int                   @default(0)
  error         String?
  createdAt     DateTime              @default(now())
  returnedAt    DateTime?

  team    Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  catalog PunchoutCatalog @relation(fields: [catalogId], references: [id], onDelete: Cascade)

  @@index([teamId])
}
