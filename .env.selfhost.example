# Self-hosted environment for docker-compose.selfhost.yml.
#   cp .env.selfhost.example .env
#   docker compose -f docker-compose.selfhost.yml up -d --build
#
# NEXT_PUBLIC_* values are baked in when the image is built: rebuild
# (`--build`) after changing them.

# Bundled Postgres. The compose file builds DATABASE_URL from these; set
# DATABASE_URL yourself only to use an external Postgres instead.
POSTGRES_USER="procurement"
POSTGRES_PASSWORD="change-me"
POSTGRES_DB="procurement"

# Host port the app is published on. Put a reverse proxy in front for TLS.
APP_PORT=4100

# NextAuth
NEXTAUTH_URL="https://procurement.yourcompany.com"
NEXTAUTH_SECRET="replace-with-openssl-rand-base64-32"

# App
APP_URL="https://procurement.yourcompany.com"

# Email (invitations, approval notifications)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Procurement <no-reply@example.com>"

# AI — routed through the Vercel AI Gateway (see lib/ai/provider.ts). Not
# needed when deployed on Vercel, which authenticates via OIDC automatically;
# required for local dev. Get one from vercel.com/dashboard -> AI Gateway.
AI_GATEWAY_API_KEY=""

# MCP server auth — bearer token required on the HTTP MCP endpoint (pages/api/mcp/[transport].ts)
MCP_SERVER_TOKEN="replace-with-a-long-random-token"

# Autonomous agent guardrails (see lib/ai/policy.ts) — hard ceiling regardless of
# per-team AgentPolicy configuration, so a bad policy row can never auto-approve
# above this no matter what an admin sets in the UI.
AGENT_MAX_AUTO_APPROVE_AMOUNT="1000"

# ── Humlens apps working together ────────────────────────────────────────────
# Same value in Commerce, Inventory and Procurement: lets people move between
# the apps without signing in again (32+ random characters, e.g. `openssl rand -hex 32`).
HUMLENS_SSO_SECRET=
# Where each app lives; shown as links in the other apps' menus.
NEXT_PUBLIC_HUMLENS_INVENTORY_URL=https://inventory.yourcompany.com
NEXT_PUBLIC_HUMLENS_PROCUREMENT_URL=https://procurement.yourcompany.com
NEXT_PUBLIC_HUMLENS_COMMERCE_URL=https://store.yourcompany.com
# Background jobs (sync, message delivery, reservation expiry) run inside the
# server process. Set to 1 on serverless hosting and use a cron instead.
DISABLE_SCHEDULER=
# Encrypts other apps' API keys stored in Settings → Integrations (defaults to
# NEXTAUTH_SECRET; changing it means re-entering them).
CONNECTIONS_SECRET=

# Accounting and ERP: optional shared OAuth apps (see .env.example).
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
SAGE_CLIENT_ID=
SAGE_CLIENT_SECRET=
